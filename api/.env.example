# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: go run ./terminal/genkey
JWT_SIGNING_SECRET=your-32-byte-hex-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
ENCRYPTION_KEY=your-32-byte-hex-aes-key

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY=10m

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
PG_ADDRESS=localhost
PG_PORT=5432
PG_USER=silo
PG_PASSWORD=silo
PG_DATABASE=silo
PG_SSL_MODE=disable

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Market Data ───────────────────────────────────────────────────────────────
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
EXCHANGERATE_API_KEY=
EXCHANGERATE_BASE_URL=https://v6.exchangerate-api.com/v6

# ─── AI (Anthropic Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Object Storage ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: s3 | r2 | minio  (leave empty to disable uploads in dev)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=silo
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_MAX_UPLOAD_BYTES=52428800  # 50 MB

# MinIO (self-hosted — already running in docker compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/silo

# AWS S3 — uncomment and set STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_URL=https://silo.s3.amazonaws.com

# Cloudflare R2 — uncomment and set STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_PUBLIC_URL=https://pub-<token>.r2.dev

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=sandbox@wearegravitylabs.com
RESEND_FROM_NAME=Silo
SUPPORT_EMAIL=hello@wearegravitylabs.com
APP_BASE_URL=http://localhost:3000

# ─── Feature Flags ─────────────────────────────────────────────────────────────
IS_SANDBOX_MODE=true
