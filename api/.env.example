# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: go run ./terminal/genkey
JWT_SIGNING_SECRET=your-32-byte-hex-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
ENCRYPTION_KEY=your-32-byte-hex-aes-key

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY=10m

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
PG_ADDRESS=localhost
PG_PORT=5432
PG_USER=silo
PG_PASSWORD=silo
PG_DATABASE=silo
PG_SSL_MODE=disable

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Market Data ───────────────────────────────────────────────────────────────
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Get a free API key at https://www.exchangerate-api.com (sign up, no card required).
# Required — without it, the daily FX rate refresh job fails and asset value
# conversion falls back to a slower live lookup (see app/exchangerate).
EXCHANGERATE_API_KEY=
EXCHANGERATE_BASE_URL=https://v6.exchangerate-api.com/v6

# Stocks — Nigerian Exchange (NG) and US equities, via NGN Market.
# Get a key at https://ngnmarket.com/developer. The Free plan (3,000 calls/month)
# is enough to browse tickers and get current prices; price HISTORY (used to
# work out what you paid on a past date) needs the Hobby plan or above.
# Without a key, the stock list endpoint returns MARKET_UNAVAILABLE and stock
# prices are not refreshed daily.
NGNMARKET_API_KEY=
NGNMARKET_BASE_URL=https://api.ngnmarket.com/v1
# Your plan's per-minute request cap (Free 30, Hobby 60, Starter/Pro 120, Business 300).
NGNMARKET_REQUESTS_PER_MINUTE=30
# Set to true ONLY on the Hobby plan or above. Lets Silo look up the price on a
# past purchase date. On the Free plan leave it false: users type in the price
# they paid, and no API calls are wasted on lookups the plan can't do.
NGNMARKET_HISTORY_ENABLED=false

# ⚠ Free plan limits: 3,000 calls/month and 30/minute, shared by everyone on your
# server. Nigerian stocks are cheap (one call a day prices the whole exchange).
# US stocks cost at least one call per different stock, per day: roughly 100
# different US stocks across all your users uses up the whole month, before any
# browsing. If you track many US stocks, move to Hobby (10,000 calls) or above.

# ─── AI (Anthropic Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Leave CLAUDE_MODEL empty to use the current default. Set it to pin a model,
# e.g. claude-opus-5-5 (most capable), claude-sonnet-5-5 (cheaper), or
# claude-haiku-5-5 (cheapest).
CLAUDE_MODEL=

# ─── Object Storage ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: s3 | r2 | minio  (leave empty to disable uploads in dev)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=silo
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_MAX_UPLOAD_BYTES=52428800  # 50 MB

# MinIO — local dev (docker compose already runs MinIO on port 9000)
# ⚠️  STORAGE_PUBLIC_URL must be a publicly reachable URL in production.
#    "localhost" only works on the same machine. In production, set this to
#    the domain/IP where MinIO is accessible — e.g. https://storage.yourdomain.com
#    Tip: for production self-hosting, consider Cloudflare R2 instead (see below).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/silo

# Cloudflare R2 — recommended for production (zero egress fees, global CDN, no server needed)
# 1. Create a bucket at dash.cloudflare.com → R2
# 2. Create an API token with object read/write permissions
# 3. Enable "Public access" on the bucket to get a pub-*.r2.dev URL
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=<r2_access_key_id>
# STORAGE_SECRET_KEY=<r2_secret_access_key>
# STORAGE_PUBLIC_URL=https://pub-<token>.r2.dev

# AWS S3
# 1. Create a bucket in the AWS console or: aws s3 mb s3://silo
# 2. Create an IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject permissions
# 3. Set bucket policy to public-read or use presigned URLs
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=<aws_access_key_id>
# STORAGE_SECRET_KEY=<aws_secret_access_key>
# STORAGE_PUBLIC_URL=https://silo.s3.amazonaws.com

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=sandbox@wearegravitylabs.com
RESEND_FROM_NAME=Silo
SUPPORT_EMAIL=hello@wearegravitylabs.com
APP_BASE_URL=http://localhost:3000

# ─── Feature Flags ─────────────────────────────────────────────────────────────
IS_SANDBOX_MODE=true
