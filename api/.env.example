# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: go run ./terminal/genkey
JWT_SIGNING_SECRET=your-32-byte-hex-secret
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=30d
ENCRYPTION_KEY=your-32-byte-hex-aes-key

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
PG_ADDRESS=localhost
PG_PORT=5432
PG_USER=silo
PG_PASSWORD=silo
PG_DATABASE=silo
PG_SSL_MODE=disable

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Market Data ───────────────────────────────────────────────────────────────
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
EXCHANGERATE_API_KEY=
EXCHANGERATE_BASE_URL=https://v6.exchangerate-api.com/v6

# ─── AI (Anthropic Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Object Storage (MinIO / S3) ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=silo
MINIO_USE_SSL=false

# ─── Email ─────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SUPPORT_EMAIL=hello@silo.app
APP_BASE_URL=http://localhost:3000

# ─── Feature Flags ─────────────────────────────────────────────────────────────
IS_SANDBOX_MODE=true
