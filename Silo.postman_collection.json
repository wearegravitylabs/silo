{
  "info": {
    "name": "Silo API",
    "description": "Complete API collection for the Silo portfolio tracker. Set the `base_url` and `access_token` variables before use.\n\n**Auth flow:**\n1. `POST /auth/send-code` → enter your email\n2. `POST /auth/verify-code` → paste the 6-digit code; copy `access_token` from the response into the collection variable\n3. `PATCH /users/me/onboard` → complete your profile\n4. `POST /portfolios` → create a portfolio, save its `id` as `portfolioID`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "access_token","value": "",   "type": "string" },
    { "key": "portfolioID", "value": "",   "type": "string" },
    { "key": "assetID",     "value": "",   "type": "string" },
    { "key": "debtID",      "value": "",   "type": "string" },
    { "key": "folderID",    "value": "",   "type": "string" },
    { "key": "lotID",       "value": "",   "type": "string" },
    { "key": "flowID",      "value": "",   "type": "string" },
    { "key": "docID",       "value": "",   "type": "string" },
    { "key": "noteID",      "value": "",   "type": "string" },
    { "key": "memberUserID","value": "",   "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Send sign-in code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/send-code", "host": ["{{base_url}}"], "path": ["auth","send-code"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sends a 6-digit OTP to the email address. Deliberately vague — never confirms whether the address exists."
          }
        },
        {
          "name": "Verify code (sign in)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.access_token) {",
                "  pm.collectionVariables.set('access_token', res.data.access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/verify-code", "host": ["{{base_url}}"], "path": ["auth","verify-code"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Exchange the OTP for an access + refresh token pair. The test script auto-saves `access_token` to the collection variable."
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh-token", "host": ["{{base_url}}"], "path": ["auth","refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<your_refresh_token>\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },

    {
      "name": "Config (public)",
      "item": [
        {
          "name": "List asset classes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/asset-classes", "host": ["{{base_url}}"], "path": ["asset-classes"] }
          }
        },
        {
          "name": "List physical subtypes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/physical-subtypes", "host": ["{{base_url}}"], "path": ["physical-subtypes"] }
          }
        },
        {
          "name": "List currencies",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/currencies", "host": ["{{base_url}}"], "path": ["currencies"] }
          }
        }
      ]
    },

    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] }
          }
        },
        {
          "name": "Onboard (complete profile)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/me/onboard", "host": ["{{base_url}}"], "path": ["users","me","onboard"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"phone_number\": \"8012345678\",\n  \"phone_country_code\": \"+234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Required before accessing any portfolio endpoint. Call once after first sign-in."
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"avatar_url\": \"https://example.com/avatar.png\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete my account",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users","me"] }
          }
        }
      ]
    },

    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload file (public bucket)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/upload", "host": ["{{base_url}}"], "path": ["upload"] },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "description": "Uploads to the public bucket. Max 50 MB. Returns a URL and storage key.\nAllowed types: image/*, application/pdf, .doc, .docx, .xls, .xlsx, text/plain."
          }
        }
      ]
    },

    {
      "name": "Portfolios",
      "item": [
        {
          "name": "Create portfolio",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.id) {",
                "  pm.collectionVariables.set('portfolioID', res.data.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios", "host": ["{{base_url}}"], "path": ["portfolios"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Portfolio\",\n  \"description\": \"Main investment portfolio\",\n  \"base_currency\": \"USD\",\n  \"image_url\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List portfolios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/portfolios",
              "host": ["{{base_url}}"],
              "path": ["portfolios"],
              "query": [
                { "key": "name",     "value": "",  "disabled": true },
                { "key": "currency", "value": "",  "disabled": true },
                { "key": "role",     "value": "",  "disabled": true },
                { "key": "page",     "value": "1", "disabled": true },
                { "key": "limit",    "value": "20","disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get portfolio",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}"] }
          }
        },
        {
          "name": "Update portfolio",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Portfolio Name\",\n  \"description\": \"Updated description\",\n  \"base_currency\": \"USD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete portfolio",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}"] }
          }
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/members", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","members"] }
          }
        },
        {
          "name": "Add member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/members", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","members"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"collaborator@example.com\",\n  \"role\": \"editor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Roles: owner | editor | viewer. Requires portfolio owner."
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/members/{{memberUserID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","members","{{memberUserID}}"] }
          }
        }
      ]
    },

    {
      "name": "Folders",
      "item": [
        {
          "name": "List folders",
          "request": {
