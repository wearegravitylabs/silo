                "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/assets/{{assetID}}/cash-flows", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","assets","{{assetID}}","cash-flows"] },
                "body": {
