            }
          }
        },
        {
          "name": "Delete folder",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/folders/{{folderID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","folders","{{folderID}}"] },
