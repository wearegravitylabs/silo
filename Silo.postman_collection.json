            {
              "name": "Search ticker",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/portfolios/{{portfolioID}}/assets/ticker/search?q=AAPL",
                  "host": ["{{base_url}}"],
                  "path": ["portfolios","{{portfolioID}}","assets","ticker","search"],
