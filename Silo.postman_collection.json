                  "mode": "raw",
                  "raw": "{\n  \"folder_id\": \"{{folderID}}\",\n  \"asset_type\": \"crypto_ticker\",\n  \"ticker\": \"BTC\",\n  \"lots\": [\n    {\n      \"quantity\": 0.5,\n      \"acquisition_date\": \"2024-03-01\",\n      \"acquisition_price\": 65000\n    }\n  ]\n}",
