              "name": "Ticker preview",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/portfolios/{{portfolioID}}/assets/ticker/preview?ticker=AAPL",
                  "host": ["{{base_url}}"],
                  "path": ["portfolios","{{portfolioID}}","assets","ticker","preview"],
                  "query": [{ "key": "ticker", "value": "AAPL" }]
                }
              }
            }
          ]
        },

        {
          "name": "CRUD",
          "item": [
