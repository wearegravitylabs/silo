            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Equities\",\n  \"icon\": \"📈\",\n  \"image_url\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/folders/{{folderID}}", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","folders","{{folderID}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stocks & ETFs\",\n  \"icon\": \"📊\"\n}",
