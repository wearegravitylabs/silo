            "body": {
              "mode": "raw",
              "raw": "{\n  \"folders\": [\n    { \"id\": \"<folder-uuid-1>\", \"position\": 0 },\n    { \"id\": \"<folder-uuid-2>\", \"position\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },

    {
      "name": "Assets",
      "item": [

        {
          "name": "Overview",
          "item": [
            {
              "name": "Asset overview",
              "request": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/portfolios/{{portfolioID}}/assets/overview", "host": ["{{base_url}}"], "path": ["portfolios","{{portfolioID}}","assets","overview"] },
                "description": "Returns aggregated metrics for the entire portfolio in its base currency."
              }
